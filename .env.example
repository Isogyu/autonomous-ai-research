# 必要なものだけ .env に写して使う（.env は Git に含めない）。すべて任意で、既定値のままでも動く。
# AAR_DATABASE_URL=postgresql://aar:aar@127.0.0.1:55432/aar
# AAR_TEMPORAL_ADDRESS=127.0.0.1:7233
# AAR_CONTACT_EMAIL=            # 論文 API の User-Agent に付ける連絡先。空なら送らない
# AAR_OPENALEX_API_KEY=         # 無料キーで1日の枠が増える（キーなしでも動く）
# AAR_SEMANTIC_SCHOLAR_API_KEY= # キーなしは共有枠で不安定
# AAR_EMBEDDING_MODEL=intfloat/multilingual-e5-small   # pip install '.[embed]' が必要。無ければ hash で代用
# AAR_MODE=real                 # mock にすると外部 API とエージェントを呼ばない（結果は mock と記録される）
# AAR_UI_PORT=8765

# ---- コンテナ（ADR-0012）。方針ファイルではなく、ここで決める
# AAR_CONTAINER_ENGINE=podman   # 既定。旧環境（macOS と Docker）でだけ docker と書く
# AAR_PODMAN_BIN=               # 空なら PATH の podman
# AAR_PODMAN_CONNECTION=        # `podman system connection list` の名前。空なら既定の接続
# AAR_PODMAN_ROOTFUL_USER=1000:1000   # rootful のときに実験のコンテナを動かす UID:GID（rootless では使わない）
# AAR_IMPROVE_IMAGE=            # 改善候補を実行するイメージ。ダイジェスト（@sha256:…）つきで書く。空なら評価しない
# AAR_IMPROVE_ALLOW_UNISOLATED_GENERATOR=0   # 候補を作る側の隔離は未完成。人が 1 にしたときだけ生成する（記録される）
# AAR_POSTGRES_IMAGE=docker.io/pgvector/pgvector:0.8.7-pg17   # 社内のミラーを使うなら、その名前
# AAR_PG_PASSWORD=              # PostgreSQL の所有者のパスワード（コンテナを最初に作るときに使う）
# ---- DB の役割を分ける（追記だけの表を、実行用の権限では書き換えられないようにする）
# AAR_MIGRATION_DATABASE_URL=   # 所有者の接続。設定すると、AAR_DATABASE_URL は実行用の役割（aar_app）として扱う
# AAR_APP_PG_PASSWORD=          # `aar migrate` が aar_app に設定するパスワード
# ---- 実行担当の CLI、時刻、スリープ
# AAR_CLAUDE_BIN=               # 空なら PATH から探す。Windows で .cmd のランチャーしかないときは、.exe の場所を書く
# AAR_CODEX_BIN=
# AAR_TIMEZONE=Asia/Tokyo       # 表示と、日次・週次の区切り。空なら OS の設定。DB の時刻は常に UTC
# AAR_TEMPORAL_NAMESPACE=default
# AAR_HOLD_ON_UNKNOWN_SLEEP=1   # 工程が失敗して電源の記録を読めないとき、失敗と決めずに保留にする
# ---- 改善の自動ループ（ADR-0014）
# AAR_IMPROVE_AUTO=0            # 1 にすると、週 1 回の改善の 1 巡を定期実行に登録する（既定は無効）
# AAR_IMPROVE_MAX_GENERATIONS_PER_CYCLE=1
# AAR_IMPROVE_MAX_PAPERS_PER_CYCLE=3   # 1 件につき、実行担当の呼び出しが 1 回
